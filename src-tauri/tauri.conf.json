{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8Pace",
  "mainBinaryName": "8Pace",
  "version": "0.1.0",
  "identifier": "app.eightpace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "8Pace",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "visible": false
      },
      {
        "label": "seletor",
        "title": "8Pace - Iniciar atividade",
        "width": 520,
        "height": 420,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/anexos/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
